# Server-only Gemini runtime configuration. Copy only if .env does not exist.
# Preserve the owner's existing .env. Never commit the populated file.
GEMINI_API_KEY=
# Reviewed: gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite.
# Exact selection required; optional models/ prefix. Metadata is not generation proof.
ORBA_PM_MODEL=
# low/medium/high for all reviewed models; minimal only for3.6 and3.5 Flash-Lite.
ORBA_PM_THINKING_LEVEL=low
# UTF8 content bytes: prompt + canonical provider schema + canonical snapshot.
# 8192-96000; equality allowed. Not provider tokens or complete HTTP wire bytes.
ORBA_PM_MAX_INPUT_BYTES=48000
ORBA_PM_TIMEOUT_SECONDS=60
ORBA_PM_MAX_OUTPUT_TOKENS=6000
ORBA_PM_MAX_CONCURRENT=2
ORBA_PM_ACCOUNT_ATTEMPTS_PER_HOUR=5
ORBA_PM_GLOBAL_ATTEMPTS_PER_HOUR=20
