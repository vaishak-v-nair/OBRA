{
  "name": "@orba/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "uv run --directory ../api python -m scripts.prepare_tests && playwright test",
    "test:e2e:negative": "playwright test --config playwright.negative.config.ts",
    "test:e2e:live": "uv run --directory ../api python -m scripts.verification live-preflight && playwright test --config playwright.live.config.ts",
    "test:e2e:controlled": "uv run --directory ../api python -m scripts.prepare_tests && playwright test --config playwright.controlled.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
